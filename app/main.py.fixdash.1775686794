@app.get("/deposit/{user_id}")
def deposit_list_user(user_id: str, limit: int = 20):
    db = SessionLocal()
    try:
        rows = (
            db.query(Deposit)
            .filter(Deposit.user_id == user_id)
            .order_by(Deposit.id.desc())
