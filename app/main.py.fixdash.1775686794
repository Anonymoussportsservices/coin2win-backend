@app.get("/wallet/{user_id}")
def wallet(user_id: str):
    db = SessionLocal()
    try:
        w = _get_or_create_user_and_wallet(db, user_id)
        db.commit()
        return _serialize_wallet(w)
    finally:
        db.close()
