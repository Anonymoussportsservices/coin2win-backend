        )
        withdrawals = (
            db.query(Withdrawal)
            .filter(Withdrawal.user_id == user_id)
            .order_by(Withdrawal.id.desc())
            .limit(10)
            .all()
        )
        txs = (
            db.query(Transaction)
            .filter(Transaction.user_id == user_id)
