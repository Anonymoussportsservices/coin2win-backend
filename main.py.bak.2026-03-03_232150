# --------------------------
# Professional error format
# --------------------------
PRO_MINIMUM_MESSAGE = (
    "Due to payment processor and network requirements, the selected cryptocurrency "
    "currently requires a higher minimum deposit. Please increase the deposit amount "
    "or select another cryptocurrency."
)
SUGGESTED_COINS_DEFAULT = ["ltc", "usdttrc20", "doge", "trx"]

def _error_response(
    *,
    error_code,
    message,
    amount_usd=None,
    pay_currency=None,
    suggestions=None,
    nowpayments=None,
):
    payload = {
        "ok": False,
        "error_code": error_code,
        "message": message,
    }
    if amount_usd is not None:
        payload["amount_usd"] = float(amount_usd)
    if pay_currency is not None:
        payload["pay_currency"] = pay_currency
    if suggestions:
        payload["suggestions"] = suggestions
    # keep for debugging; remove later if you don’t want it exposed externally
    if nowpayments:
        payload["nowpayments"] = nowpayments
    return payload

def _np_headers():
    return {
        "x-api-key": NOWPAYMENTS_API_KEY,
        "Content-Type": "application/json",
    }

# --------------------------
# Database (Postgres)
# --------------------------
Base = declarative_base()

class User(Base):
    __tablename__ = "users"
    id = Column(String(64), primary_key=True)  # we keep your "user_1" style IDs for now
    created_at = Column(DateTime(timezone=True), server_default=func.now())
    wallet = relationship("Wallet", uselist=False, back_populates="user")

class Wallet(Base):
    __tablename__ = "wallets"
    id = Column(Integer, primary_key=True, autoincrement=True)
    user_id = Column(String(64), ForeignKey("users.id", ondelete="CASCADE"), unique=True, nullable=False)
    balance_usd = Column(Float, nullable=False, default=0.0)
    updated_at = Column(DateTime(timezone=True), server_default=func.now(), onupdate=func.now())

    user = relationship("User", back_populates="wallet")

class Deposit(Base):
    __tablename__ = "deposits"
    id = Column(Integer, primary_key=True, autoincrement=True)
    user_id = Column(String(64), ForeignKey("users.id", ondelete="CASCADE"), nullable=False)

    payment_id = Column(String(64), nullable=False)  # NOWPayments payment_id
    status = Column(String(32), nullable=False, default="waiting")

    amount_usd = Column(Float, nullable=False)
    pay_currency = Column(String(32), nullable=False)

    pay_amount = Column(Float, nullable=True)
    pay_address = Column(Text, nullable=True)

    raw_create_response = Column(Text, nullable=True)

    created_at = Column(DateTime(timezone=True), server_default=func.now())
    updated_at = Column(DateTime(timezone=True), server_default=func.now(), onupdate=func.now())

    __table_args__ = (
        UniqueConstraint("payment_id", name="uq_deposits_payment_id"),
    )

class Transaction(Base):
    __tablename__ = "transactions"
    id = Column(Integer, primary_key=True, autoincrement=True)
    user_id = Column(String(64), ForeignKey("users.id", ondelete="CASCADE"), nullable=False)
    type = Column(String(32), nullable=False)  # deposit, bet, win, withdrawal
    amount = Column(Float, nullable=False)
    balance_after = Column(Float, nullable=False)
    reference = Column(String(128), nullable=True)  # e.g. payment_id
    created_at = Column(DateTime(timezone=True), server_default=func.now())

engine = create_engine(DATABASE_URL, pool_pre_ping=True, future=True)
SessionLocal = sessionmaker(bind=engine, autoflush=False, autocommit=False, future=True)

@app.on_event("startup")
def _startup():
    Base.metadata.create_all(bind=engine)

def _get_or_create_user_and_wallet(db, user_id: str):
    user = db.get(User, user_id)
    if not user:
        user = User(id=user_id)
        db.add(user)
        db.flush()
    wallet = db.query(Wallet).filter(Wallet.user_id == user_id).one_or_none()
    if not wallet:
        wallet = Wallet(user_id=user_id, balance_usd=0.0)
        db.add(wallet)
        db.flush()
    return user, wallet

