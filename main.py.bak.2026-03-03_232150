@app.post("/payments/nowpayments/estimate")
async def nowpayments_estimate(request: Request):
    body = await request.json()
    amount_usd = float(body.get("amount_usd", 0))
    pay_currency = str(body.get("pay_currency", "")).lower().strip()

    if amount_usd <= 0:
        raise HTTPException(status_code=400, detail="amount_usd must be > 0")
    if not pay_currency:
        raise HTTPException(status_code=400, detail="pay_currency required")

    url = "https://api.nowpayments.io/v1/estimate"
    payload = {"amount": amount_usd, "currency_from": "usd", "currency_to": pay_currency}
    r = requests.post(url, headers=_np_headers(), json=payload, timeout=30)
    return r.json()

@app.post("/deposit/create")
async def deposit_create(request: Request):
    body = await request.json()
    user_id = str(body.get("user_id", "")).strip()
    amount_usd = float(body.get("amount_usd", 0))
    pay_currency = str(body.get("pay_currency", "")).lower().strip()

    if not user_id:
        raise HTTPException(status_code=400, detail="user_id required")
    if amount_usd <= 0:
        raise HTTPException(status_code=400, detail="amount_usd must be > 0")
    if amount_usd < MIN_DEPOSIT_USD:
        raise HTTPException(status_code=400, detail=f"Minimum deposit is ${MIN_DEPOSIT_USD:.0f} USD")
    if not pay_currency:
        raise HTTPException(status_code=400, detail="pay_currency required")

    # Create NOWPayments payment
    url = "https://api.nowpayments.io/v1/payment"
    payload = {
        "price_amount": amount_usd,
        "price_currency": "usd",
        "pay_currency": pay_currency,
        "ipn_callback_url": IPN_CALLBACK_URL,
        "order_id": f"{user_id}_{int(time.time())}",
        "order_description": f"Coin2Win deposit for {user_id}",
    }

    r = requests.post(url, headers=_np_headers(), json=payload, timeout=30)
    data = r.json()

    if not data.get("payment_id"):
        return _error_response(
            error_code="COIN_MINIMUM_HIGHER_THAN_AMOUNT",
            message=PRO_MINIMUM_MESSAGE,
            amount_usd=amount_usd,
            pay_currency=pay_currency,
            suggestions=SUGGESTED_COINS_DEFAULT,
            nowpayments=data,
        )

    payment_id = str(data["payment_id"])

    # Persist deposit + ensure user/wallet exist
    db = SessionLocal()
    try:
        _get_or_create_user_and_wallet(db, user_id)

        dep = Deposit(
            user_id=user_id,
            payment_id=payment_id,
            status=str(data.get("payment_status") or "waiting"),
            amount_usd=amount_usd,
            pay_currency=pay_currency,
            pay_amount=float(data.get("pay_amount")) if data.get("pay_amount") is not None else None,
            pay_address=data.get("pay_address"),
            raw_create_response=json.dumps(data),
        )
        db.add(dep)
        db.commit()
    except IntegrityError:
        db.rollback()
        # If duplicate payment_id somehow, just return a clean response
        raise HTTPException(status_code=409, detail="Deposit already exists for this payment.")
    finally:
        db.close()

    return {
        "ok": True,
        "payment_id": payment_id,
        "status": data.get("payment_status"),
        "price_amount_usd": amount_usd,
        "pay_currency": pay_currency,
        "pay_amount": data.get("pay_amount"),
        "pay_address": data.get("pay_address"),
        "payment_url": data.get("payment_url"),
    }

@app.post("/webhooks/nowpayments")
async def nowpayments_webhook(request: Request):
    raw_body = await request.body()
    received_sig = request.headers.get("x-nowpayments-sig")
    if not received_sig:
        raise HTTPException(status_code=400, detail="Missing x-nowpayments-sig header")

    generated_sig = hmac.new(
        NOWPAYMENTS_IPN_SECRET.encode(),
        raw_body,
        hashlib.sha512,
    ).hexdigest()

    if generated_sig != received_sig:
        raise HTTPException(status_code=400, detail="Invalid signature")

    data = json.loads(raw_body.decode("utf-8"))
    payment_id = str(data.get("payment_id", "")).strip()
    payment_status = str(data.get("payment_status", "")).lower().strip()

    if not payment_id:
        raise HTTPException(status_code=400, detail="Missing payment_id in webhook")

    db = SessionLocal()
    try:
        dep = db.query(Deposit).filter(Deposit.payment_id == payment_id).one_or_none()
        if not dep:
            raise HTTPException(status_code=400, detail="Unknown payment_id")

        # Update deposit status always
        dep.status = payment_status

        # Credit only once, only when finished
        if payment_status == "finished":
            if dep.status == "credited":
                db.commit()
                return {"ok": True, "message": "Already credited"}

            # Lock wallet row logically by doing everything in one transaction
            _get_or_create_user_and_wallet(db, dep.user_id)
            wallet = db.query(Wallet).filter(Wallet.user_id == dep.user_id).with_for_update().one()

            new_balance = round(float(wallet.balance_usd) + float(dep.amount_usd), 2)
            wallet.balance_usd = new_balance

            tx = Transaction(
                user_id=dep.user_id,
                type="deposit",
                amount=float(dep.amount_usd),
                balance_after=new_balance,
                reference=payment_id,
            )
            db.add(tx)

            dep.status = "credited"

        db.commit()
        return {"ok": True, "payment_id": payment_id, "status": payment_status}
    finally:
        db.close()

@app.get("/wallet/{user_id}")
def wallet(user_id: str):
    db = SessionLocal()
    try:
        w = db.query(Wallet).filter(Wallet.user_id == user_id).one_or_none()
        bal = float(w.balance_usd) if w else 0.0
        return {"user_id": user_id, "balance_usd": bal}
    finally:
        db.close()

@app.get("/admin/deposits")
def admin_deposits(limit: int = 50):
    db = SessionLocal()
    try:
        rows = (
            db.query(Deposit)
            .order_by(Deposit.id.desc())
            .limit(max(1, min(limit, 200)))
            .all()
        )
        return {
            "count": len(rows),
            "deposits": [
                {
                    "id": d.id,
                    "user_id": d.user_id,
                    "payment_id": d.payment_id,
                    "status": d.status,
                    "amount_usd": d.amount_usd,
                    "pay_currency": d.pay_currency,
                    "pay_amount": d.pay_amount,
                    "pay_address": d.pay_address,
                    "created_at": str(d.created_at),
                }
                for d in rows
            ],
        }
    finally:
        db.close()